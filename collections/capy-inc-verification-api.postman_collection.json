          "name": "Verify a Lemin cropped-captcha answer",
          "request": {
            "name": "Verify a Lemin cropped-captcha answer",
            "description": {
              "content": "Validate the encrypted answer a visitor produced for a Lemin cropped (gamified puzzle) CAPTCHA challenge. Call this from your back end only; the `private_key` must never be sent from the browser. The endpoint always responds with HTTP 200 and a JSON body whose `success` boolean carries the verification outcome; failures include a machine-readable `code` and human-readable `message`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "captcha",
                "v1",
                "cropped",
                "validate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"private_key\": \"<uuid>\",\n  \"challenge_id\": \"<uuid>\",\n  \"answer\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "91bcea52-0db1-47fb-aecc-2b1b9d9551ec",
              "name": "Verification result. Returned for both successful and failed verifications; inspect the `success` field.",
              "originalRequest": {
